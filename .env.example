# Copy to .env (already gitignored) and fill in real values.

# Only needed if you switch database.js off the local-SQLite-in-volume setup
# (see docker-compose.yml) and back to Turso.
# TURSO_AUTH_TOKEN=

# FleetHub integration (lib/fleethub.js). Leave FLEETHUB_URL unset to disable.
# When set, fleet-tracked rental items can't be issued until FleetHub confirms
# the unit passed its pre-rental checklist.
# FLEETHUB_URL=http://localhost:3100
# FLEETHUB_API_KEY=   # must match POS_API_KEY in FleetHub's .env
