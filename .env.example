# Copy to .env (already gitignored) and fill in real values.

# Only needed if you switch database.js off the local-SQLite-in-volume setup
# (see docker-compose.yml) and back to Turso.
# TURSO_AUTH_TOKEN=

# FleetHub (lib/fleethub.js) — off unless FLEETHUB_URL is set. When set, rental
# items FleetHub has units for can't go out until FleetHub confirms each unit
# passed its pre-rental checklist. The key is generated in FleetHub under
# Admin → POS connection. On the same Docker host: http://fleethub:3000
# FLEETHUB_URL=
# FLEETHUB_API_KEY=
